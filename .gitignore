# Public datasets downloaded by ml/prepare_external_datasets.py and the trainer feature cache
ml/dataset/external/
ml/dataset/.build_cache/

# Real VPS traffic and telemetry (production data) - never commit; transfer privately
ml/dataset/*.jsonl
ml/dataset/*.stats.json
ml/telemetry/
# Candidate model binaries (reproducible from code; reports/manifests are committed)
ml/models/archive/**/*.joblib
ml/models/gen3/*.joblib
ml/models/gen3/*.onnx
# the chosen Gen 3 model (F-canon2, public data only) is tracked so others can test it
!ml/models/gen3/gen3_f_model.onnx
# built on the serving host by ml/onnx_export.py
ml/models/random_forest_waf.onnx
ml/models/onnx_manifest.json
ml/models/archive/**/*.onnx
ml/onnx_export.py.orig

# security test artifacts (local traffic, do not commit)
ml/security_test/reports/
ml/security_test/decisions.jsonl
ml/security_test/results.json
